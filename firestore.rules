rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles: users can read/write their own profile; admins can do anything
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Enrollments: students can read their own enrollments; admins can read/write anything
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.studentId == request.auth.uid || 
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid) + '_' + resource.data.courseId) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Courses: catalog public to read; admins can write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Lectures: only enrolled students and admins can view lecture details/links
    match /courses/{courseId}/lectures/{lectureId} {
      allow read: if request.auth != null && (
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid) + '_' + courseId) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Fallback catcher: require authenticated session
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
